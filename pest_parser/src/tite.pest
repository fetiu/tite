program     = { SOI ~ sequence ~ EOI }
sequence    = { declaration ~ (delim ~ declaration)* }
declaration = { (tag? ~ primary ~ ":" ~ lf? )? ~ expression }
expression  = { star? ~ (assignment | set) }
star        = { "*" ~ lf? }
assignment  = { set? ~ access ~ expression }
set         = { input ~ set? | condition }
condition   = { disjunction ~ (lf? ~ "?" ~ lf? ~ (expression | otherwise))? }
otherwise   = { expression? ~ lf? ~ ":" ~ lf? ~ condition }
disjunction = { conjunction ~ (lf? ~ "||" ~ lf? ~ conjunction)* }
conjunction = { bitwise_or ~ (lf? ~ "&&" ~ lf? ~ bitwise_or)* }
bitwise_or  = { bitwise_xor ~ (lf? ~ "|" ~ lf? ~ bitwise_xor)* }
bitwise_xor = { bitwise_and ~ (lf? ~ "^" ~ lf? ~ bitwise_and)* }
bitwise_and = { equality ~ (lf? ~ "&" ~ lf? ~ equality)* }
equality    = { relation ~ (lf? ~ equality_op ~ lf? ~ relation)* }
equality_op = { "==" | "!=" | "===" | "!==" }
relation    = { shift ~ (lf? ~ relation_op ~ lf? ~ shift)* }
relation_op = { "<" | ">" | "<=" | ">=" }
shift       = { sum ~ (lf? ~ shift_op ~ lf? ~ sum)* }
shift_op    = { "<<" | ">>" }
sum         = { term ~ (lf? ~ sum_op ~ lf? ~ term)* }
sum_op      = { "+" | "-" }
term        = { factor ~ (lf? ~ term_op ~ lf? ~ factor)* }
term_op     = { "*" | "/" | "%" | "//" }
factor      = { prefix_factor | abs_factor | power }
prefix_factor = { prefix_op ~ lf? ~ factor }
prefix_op   = { "++" | "--" | "+" | "-" | "~" | "!" }
abs_factor  = { "|" ~ factor ~ "|" }
power       = { postfix ~ (lf? ~ "**" ~ lf? ~ factor)? }
postfix     = { range ~ postfix_op* }
postfix_op  = { lf? ~ ("++" | "--" | input) }
range       = { primary ~ (lf? ~ range_op ~ lf? ~ primary)? | range_op ~ lf? ~ primary }
range_op    = { ".." | "..<" }
primary     = { identifier | literal }
tag         = { "." | "$" | "#" }
assign      = { "=" | "=>" | "<-" | "*=" | "/=" | "%=" | "//=" | "**=" | "+=" | "-=" | "<<=" | ">>=" | "&=" | "^=" | "|=" }
access      = { (assign | dot_access | "@") ~ lf? }
dot_access  = { lf? ~ "." }
literal     = { float | int | char | string | block | array | tuple }
input       = { array | tuple | macro }
block       = { "{" ~ lf* ~ sequence? ~ lf* ~ "}" }
array       = { "[" ~ lf* ~ sequence? ~ lf* ~ "]" }
tuple       = { "(" ~ lf* ~ sequence? ~ lf* ~ ")" }
macro       = { "<" ~ lf* ~ sequence? ~ lf* ~ ">" }
delim       = { (lf | ",") ~ lf* }
identifier  = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }
int         = @{ hex_int | oct_int | bin_int | dec_int }
hex_int     = @{ "0x" ~ ASCII_HEX_DIGIT+ }
oct_int     = @{ ("0o" | "0") ~ oct_digit+ }
bin_int     = @{ "0b" ~ bin_digit+ }
dec_int     = @{ ASCII_DIGIT+ }
float       = @{ ASCII_DIGIT* ~ "." ~ ASCII_DIGIT+ }
char        = @{ "'" ~ char_inner ~ "'" }
char_inner  = @{ "\\'" | !"'" ~ ANY }
string      = @{ short_string | long_string | raw_string }
short_string = @{ '"' ~ short_string_inner* ~ '"' }
short_string_inner = @{ "\\\"" | !'"' ~ ANY }
long_string = @{ "\"\"\"" ~ lf* ~ long_string_inner* ~ "\"\"\"" }
long_string_inner = @{ !"\"\"\"" ~ ANY }
raw_string  = @{ "`" ~ raw_string_inner* ~ "`" }
raw_string_inner = @{ !"`" ~ ANY }
oct_digit   = _{ '0'..'7' }
bin_digit   = _{ '0'..'1' }
lf          = _{ ("\r\n" | "\n" | "\r")+ }
WHITESPACE  = _{ " " | "\t" }

