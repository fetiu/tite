a: int = 1

f: () => () => 1 // valid. but for simplicity, see next
f: ()()int =>> 1 // somewhat differnt from ts, but concise
// Or we have to put "literal" to code rule, but this makes:
f: ()()int => () => 1
// hmm not bad?
f: <T>()()T => <T>()=>T
// the main problem is that code may provide "type" without value,
// this may cause semantic problems... but "=>>" feels too jargony.
// our goal is make this familar to JS devs as much as possible.
// there is no choice but to provide literal here. the end.
// to make '>' always come with '=', let's put "literal" here.

// generic is something that only be a type, not the value.
// so we'd better not provide literal to union.
// but maybe.. 

// type should contain names that 

<>[]()
<>()[]
<>[]int
<>[]int() // invalid
<>[]()int // array of functions
<>()int[] // invalid
<>()[]int // function returns array

<>[]map<> // valid
<>()map<> // valid

<>[]()map<> // array of functions returns map
<>()[]map<> // function returns array of map

[]<>() // array of template function?

f:(){
    // declarative body
}

// but this should be called... twice? no
f() // does it return body right away?

f:()1 // this is also possible.
f() // returns constant 1.

