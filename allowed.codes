    ret: f64 = x/2
    ret == NaN ? null : ret
}

// remember, there are two types of '?'
// one should be evaluated as whole expr "a?b:c",
// the other should be evaluated as unary "a?"
// the latter needs to be used for "?." or "?:"
// but as a side effect, it enables things like:
f64? // functions as rust `Option<f64>`
cond? ? expr // nullish coalcasing operator
// this approach aligns with additive/prefix +/-

a[0]?.member // should be valid
a<T>?.member // should be valid
a(p)?.member // should be valid
c?: literal // we might have to allow posfix on key
c ? literal : literal
isTrue()?.member
isTrue()?: invalid
// why not primary -> weird non-member access
a?[0] // invalid
a?<T> // invalid
a?(a) // invalid
// why not postfix -> couldn't do member access
// although member access looks like binary ops
// it doesn't have to be conditional expression
// instead, we can achieve with recursive "call"

call? ? literal // how do we distinguish it from '??'
// or maybe we just can.. removing '??' operator...
call?? literal : literal
