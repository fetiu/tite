// can a generic operator come later than array indicing?
// can a function be called like `a[0]<string>()`?
const a = [<T>() => {}]
// TS defined it as it must be type annotated before such a thing
const a = <T>() => T = [<T>() => {return "hello" as unknown as T;}]
a[0]();
// but it was not valid from the first place. the correct way was
const a = <T>(param: T): T => "hello" as unknown as T;
const a: <T>(param: T): T = ()=>{} // also works in TS, kinda dirty

// possible candidates for call non-terminal name:
