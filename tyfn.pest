json = object | array ;

object = '{' members '}' ;
members = ( member ( ',' member )* )? ;
member = string ':' value ;

array = '[' elements ']' ;
elements = ( value ( ',' value )* )* ;

value = string | number | object | array | boolean | "null" ;

string = '"' ( '"' | '\\' | [^"\] )* '"' ;
number = [0-9]+ ( '.' [0-9]+ )? ( ('e'|'E') ('+'|'-')? [0-9]+ )? ;
boolean = "true" | "false" ;
