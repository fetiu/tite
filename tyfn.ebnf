# PEG + EBNF grammar: https://docs.python.org/3/reference/introduction.html#notation

program = expressions
expressions = expression (',' expression)*
expression = literal | binding
binding = name ':' literal
literal = generic? type ['=' value]
value = data | code
code = '>' literal
data = INT | FLOAT | CHAR | STR | object
type = data | union | (array | params) type?
generic = '<' expressions? '>'
object = '{' expressions? '}'
params = '(' expressions? ')'
array = '[' expressions? ']'
union: name ('|' name)*
name: '.'? identifier | data
postfix = identifier generic?
