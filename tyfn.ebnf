program = expressions ;
expressions = expression { ',' expression } ;
expression = [ literal ':' ] literal ;
literal = [ generic ] type [ '=' value ] ;
type = option | ( array | tuple ) type ;
value = option | code ;
code = '>' literal ;
member = '.' call ;
option = or [ '?' ( expression | member ) ] ;
or = and { ( '||' | '??' ) and } ;
and = union { '&&' union } ;
union = xor { '|' xor } ;
xor = intersect { '^' intersect } ;
intersect = equality { '&' equality } ;
equality = relation { ( '==' | '!=' | '===' | '!==' ) relation } ;
relation = range { ( '<' | '>' | '<=' | '>=' | '<:' ) range } ;
range = shift | [ shift ] ('..' | '..=') [ shift ] ;
shift = additive { ( '<<' | '>>' | '>>>' ) additive } ;
additive = multiply { ( '+' | '-' ) multiply } ;
multiply = power { ( '*' | '/' | '%' ) power } ;
power = prefix { '**' prefix } ;
prefix = postfix | ( '++' | '--' | '+' | '-' | '~' | '!' ) prefix ;
postfix = call [ '++' | '--' ] ;
call = primary [ generic ] { member | array | tuple } ;
primary = [ '...' | '.' ] ( identifier | data ) ;
data = int | float | char | str | object | array | tuple;
generic = '<' [ expressions ] '>' ;
object = '{' [ expressions ] '}' ;
array = '[' [ expressions ] ']' ;
tuple = '(' [ expressions ] ')' ;
