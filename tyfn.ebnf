program = expressions ;
expressions = expression { comma expression } ;
expression = binding | literal ;
binding = literal ':' literal ;
literal = [ generic ] type [ assign value ] ;
type = condition | ( array | tuple ) type ;
value = condition | closure ;
assign = [ operator ] '=' ;
closure = '>' literal ;
condition = or [ '?' expression ] ;
or = and { '||' and } ;
and = union { '&&' union } ;
union = xor { '|' xor } ;
xor = intersect { '^' intersect } ;
intersect = equality { '&' equality } ;
equality = relation { ( '==' | '!=' | '===' | '!==' ) relation } ;
relation = range { ( '<' | '>' | '<=' | '>=' | '<:' ) range } ;
range = shift | [ shift ] ('..' | '..=') [ shift ] ;
shift = additive { ( '<<' | '>>' | '>>>' ) additive } ;
additive = multiply { ( '+' | '-' ) multiply } ;
multiply = power { ( '*' | '/' | '%' | '//' ) power } ;
power = prefix { '**' prefix } ;
prefix = postfix | ( '++' | '--' | '+' | '-' | '~' | '!' ) prefix ;
postfix = apply [ '++' | '--' ] ;
member = '.' apply ;
apply = term [ generic ] { array | tuple | member } [ '?' ] ;
term = [ '...' ] ( name | data ) | operator ;
name = [ '.' ] identifier ;
data = int | float | char | str | object | array | tuple ;
operator = arithmetic | bitwise ;
bitwise = '|' | '^' | '&' | '<<' | '>>' | '>>>' ;
arithmetic = '+' | '-' | '*' | '/' | '%' | '//' | '**' ;
generic = '<' [ expressions ] '>' ;
array = '[' [ expressions ] ']' ;
tuple = '(' [ expressions ] ')' ;
object = '{' [ expressions ] '}' ;
comma = ',' | newline ;
newline = '\r' [ '\n' ] | '\n' [ '\r' ] ;
